{
    "model_name": "ResNet50",
    "model_filename": "best_food_freshness_model.keras",
    "optimizer": "rmsprop",
    "preprocessing": "resnet50",
    "image_size": [
        224,
        224
    ],
    "classes": {
        "0": "Fresh",
        "1": "Rotten"
    },
    "threshold": 0.5,
    "pretrained_weights": "ImageNet",
    "learning_strategy": "Transfer Learning",
    "training_images": 8389,
    "validation_images": 1798,
    "test_images": 1799,
    "dense_units": 128,
    "dropout": 0.3,
    "learning_rate": 0.0003,
    "augmentation": {
        "rotation_range": 20,
        "width_shift_range": 0.1,
        "height_shift_range": 0.1,
        "zoom_range": 0.2,
        "horizontal_flip": true,
        "confusion_matrix":[
    [TN_or_FreshCorrect, FreshToRotten],
    [RottenToFresh, RottenCorrect]
]
    }
}